<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========== 父工程:Spring Boot 统一管版本/插件(BOM 一网打尽) ========== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- ========== 坐标:项目的全球唯一标识 ========== -->
    <groupId>io.github.likeelysia</groupId>
    <artifactId>formal-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <!-- ========== 门面信息:开源项目必备 ========== -->
    <name>Formal Agent</name>
    <description>My first open-source AI Agent project. 我的第一个开源 AI Agent 项目。</description>
    <url>https://github.com/likeelysia/formal-agent</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>likeelysia</id>
            <name>likeelysia</name>
            <email>likeelysia@users.noreply.github.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/likeelysia/formal-agent.git</connection>
        <developerConnection>scm:git:git@github.com:likeelysia/formal-agent.git</developerConnection>
        <url>https://github.com/likeelysia/formal-agent</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/likeelysia/formal-agent/issues</url>
    </issueManagement>

    <!-- ========== 编译参数(Boot 父工程据此设置编译 release) ========== -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ========== 依赖:版本基本交给 Boot BOM,只有 BOM 没管的才写版本 ========== -->
    <dependencies>
        <!-- Boot 核心:自动配置 + 内嵌容器 + 日志(SLF4J/Logback)+ spring-context -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 重试(AOP 切面式) -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <!-- @EnableRetry 注解式重试需要 aspectj 支持 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- PDF 解析(Boot BOM 不管,自己写版本) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- 测试:JUnit 5 + AssertJ + Mockito + spring-test 全家桶 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ========== 构建插件:打"可执行 jar" ========== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
